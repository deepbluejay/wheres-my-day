    "Skipping approvals removes the last defense against prompt injection and direct deletion.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인을 생략하면 프롬프트 주입과 직접 삭제를 막는 마지막 방어가 사라집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "承認を省略すると、プロンプトインジェクションと直接削除に対する最後の防御がなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "跳过批准会移除防范提示注入和直接删除的最后一道防线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "略過核准會移除防範提示注入和直接刪除的最後一道防線。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Überspringen von Genehmigungen entfernt den letzten Schutz vor Prompt-Injection und direktem Löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ignorer les autorisations supprime la dernière protection contre l’injection de consignes et la suppression directe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omitir las autorizaciones elimina la última defensa contra la inyección de instrucciones y la eliminación directa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Пропуск разрешений убирает последнюю защиту от внедрения инструкций и прямого удаления."
          }
        }
      }
    },
