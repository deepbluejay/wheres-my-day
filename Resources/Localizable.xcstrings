    "Recorded days could not be read. Retry by reopening the calendar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded days could not be read. Retry by reopening the calendar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 있는 날짜를 읽지 못했습니다. 달력을 다시 열어 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のある日を読み込めませんでした。カレンダーを開き直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取有记录的日期。请重新打开日历重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取有記錄的日期。請重新開啟日曆重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgezeichnete Tage konnten nicht gelesen werden. Öffnen Sie den Kalender erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les jours enregistrés. Rouvrez le calendrier pour réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los días registrados. Vuelve a abrir el calendario."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать дни с записями. Откройте календарь заново."
          }
        }
      }
    },
