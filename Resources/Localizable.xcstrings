    "One square is one minute; time runs bottom to top in each column.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네모 하나는 1분이며, 각 열의 시간은 아래에서 위로 흐릅니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "1つの四角は1分で、各列の時間は下から上に進みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每个方格代表1分钟，每列的时间从下往上排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "每個方格代表1分鐘，每欄的時間從下往上排列。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Quadrat entspricht einer Minute; die Zeit läuft in jeder Spalte von unten nach oben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un carré représente une minute ; le temps va de bas en haut dans chaque colonne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cada cuadrado es un minuto; el tiempo avanza de abajo arriba en cada columna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Один квадрат — одна минута; время в каждом столбце идёт снизу вверх."
          }
        }
      }
    },
