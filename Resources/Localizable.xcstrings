    "Continue with %@. Earlier messages stay here; the new provider starts with your next message.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with %@. Earlier messages stay here; the new provider starts with your next message."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@로 이어갑니다. 이전 대화는 여기에 남고, 새 제공자에게는 다음 메시지부터 보냅니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で続けます。以前のメッセージはここに残り、新しいプロバイダーには次のメッセージから送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续使用 %@。之前的消息保留在此，新提供商从你的下一条消息开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續使用 %@。之前的訊息保留在此，新供應商從你的下一則訊息開始。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ fortfahren. Bisherige Nachrichten bleiben hier; der neue Anbieter beginnt mit Ihrer nächsten Nachricht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer avec %@. Les messages précédents restent ici ; le nouveau fournisseur commence avec votre prochain message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar con %@. Los mensajes anteriores permanecen aquí; el nuevo proveedor empieza con tu siguiente mensaje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжение с %@. Прежние сообщения остаются здесь; новый поставщик начнёт со следующего сообщения."
          }
        }
      }
    },
    "Settings could not be read. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be read. Try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 읽지 못했습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み取れませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取设置。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取設定。請重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen konnten nicht gelesen werden. Erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les réglages. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los ajustes. Inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать настройки. Повторите попытку."
          }
        }
      }
    },
    "Stopped because the provider disconnected. Actions already executed are not undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped because the provider disconnected. Actions already executed are not undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 연결이 끊겨 중지했습니다. 이미 실행한 동작은 되돌아가지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーの接続が切れたため停止しました。実行済みの操作は元に戻りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因提供商断开连接而停止。已执行的操作不会撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因供應商中斷連線而停止。已執行的操作不會復原。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt, weil der Anbieter getrennt wurde. Bereits ausgeführte Aktionen werden nicht rückgängig gemacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt suite à la déconnexion du fournisseur. Les actions déjà exécutées ne sont pas annulées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo al desconectarse el proveedor. Las acciones ya ejecutadas no se deshacen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановлено из-за отключения поставщика. Уже выполненные действия не отменяются."
          }
        }
      }
    },
    "Stopped because the approval setting changed. Actions already executed are not undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
