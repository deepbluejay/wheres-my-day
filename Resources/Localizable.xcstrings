    "Records cannot be restored after disk loss or moving to another Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크를 잃거나 Mac을 바꾸면 기록을 복원할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ディスクの紛失や別のMacへの移行後は記録を復元できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "磁盘丢失或更换Mac后无法恢复记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "磁碟遺失或更換Mac後無法還原記錄。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nach einem Festplattenverlust oder Mac-Wechsel lassen sich die Aufzeichnungen nicht wiederherstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les données ne peuvent pas être restaurées après la perte du disque ou un changement de Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los registros no se pueden restaurar si pierdes el disco o cambias de Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Записи нельзя восстановить при потере диска или переходе на другой Mac."
          }
        }
      }
    },
    "Records may still be backed up because backup exclusion has not been established.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 제외가 확인되지 않아 기록이 여전히 백업될 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップからの除外が確認されていないため、記録が引き続きバックアップされる可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认排除备份，因此记录仍可能被备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未確認排除備份，因此記錄仍可能被備份。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da der Backup-Ausschluss nicht bestätigt ist, werden Aufzeichnungen möglicherweise weiterhin gesichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exclusion des sauvegardes n’étant pas confirmée, les enregistrements peuvent encore être sauvegardés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros podrían seguir incluyéndose en copias de seguridad porque no se ha confirmado su exclusión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исключение из резервных копий не подтверждено, поэтому записи всё ещё могут сохраняться в них."
          }
        }
      }
    },
