    "Retention changed elsewhere. Your draft is kept. Reload saved values before applying.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳에서 보관 기간이 바뀌었습니다. 입력한 값은 유지됩니다. 저장된 값을 다시 불러온 뒤 적용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の場所で保存期間が変更されました。入力内容は保持されます。保存済みの値を再読み込みしてから適用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留期限已在其他位置更改。草稿已保留。请重新载入已保存的值后再应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留期限已在其他位置變更。草稿已保留。請重新載入已儲存的值後再套用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufbewahrung wurde andernorts geändert. Ihr Entwurf bleibt erhalten. Laden Sie vor dem Anwenden die gespeicherten Werte neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée de conservation a été modifiée ailleurs. Votre brouillon est conservé. Rechargez les valeurs enregistrées avant de les appliquer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La retención cambió en otro lugar. Se conserva el borrador. Recarga los valores guardados antes de aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок хранения изменён в другом месте. Ваш черновик сохранён. Перед применением загрузите сохранённые значения."
          }
        }
      }
    },
