        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我们会读取并总结代理对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我們會讀取並摘要代理對話。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
