          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zusammenfassungen und das Lesen von Agentenprotokollen sind pausiert, bis du mit ChatGPT fortfährst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les résumés et la lecture des journaux d’agents sont en pause jusqu’à ce que vous continuiez avec ChatGPT."
