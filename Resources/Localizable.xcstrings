    "A newer connection or disconnect replaced this attempt. Connect again to allow access.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중의 연결 또는 연결 해제가 이 시도를 대체했습니다. 접근을 허용하려면 다시 연결하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後から行われた接続または接続解除により、この試行は置き換えられました。アクセスを許可するには再接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后续连接或断开连接操作已替代本次尝试。请重新连接以允许访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後續連線或中斷連線操作已取代本次嘗試。請重新連線以允許存取。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuerer Verbindungs- oder Trennvorgang hat diesen Versuch ersetzt. Verbinden Sie sich erneut, um Zugriff zu erlauben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une connexion ou déconnexion plus récente a remplacé cette tentative. Reconnectez-vous pour autoriser l’accès."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conexión o desconexión posterior sustituyó este intento. Conecta de nuevo para permitir el acceso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более позднее подключение или отключение заменило эту попытку. Подключитесь снова, чтобы разрешить доступ."
          }
        }
      }
    },
