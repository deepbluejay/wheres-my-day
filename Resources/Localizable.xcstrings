      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 대화를 읽고 요약합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エージェントとの会話を読み、要約します。"
          }
