    "This database is outside the app data folder. Exclusion was skipped to avoid changing another folder. Use the default database location to protect backups.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터베이스는 앱 자료 폴더 밖에 있습니다. 다른 폴더를 바꾸지 않도록 백업 제외를 건너뛰었습니다. 백업에서 보호하려면 기본 데이터베이스 위치를 사용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデータベースはアプリのデータフォルダ外にあります。別のフォルダを変更しないよう除外を省略しました。バックアップから保護するには標準の保存場所を使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此数据库位于应用数据文件夹之外。为避免修改其他文件夹，已跳过排除。请使用默认数据库位置以防止备份记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此資料庫位於應用程式資料檔案夾之外。為避免修改其他檔案夾，已略過排除。請使用預設資料庫位置以防止備份記錄。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datenbank liegt außerhalb des App-Datenordners. Der Ausschluss wurde übersprungen, um keinen anderen Ordner zu ändern. Verwenden Sie den Standardort, um Backups auszuschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette base se trouve hors du dossier de données de l’application. L’exclusion a été ignorée pour ne pas modifier un autre dossier. Utilisez l’emplacement par défaut pour exclure les sauvegardes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta base está fuera de la carpeta de datos de la app. Se omitió la exclusión para no modificar otra carpeta. Usa la ubicación predeterminada para excluir las copias de seguridad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта база находится вне папки данных приложения. Исключение пропущено, чтобы не изменять другую папку. Используйте стандартное расположение базы для исключения из резервных копий."
          }
        }
      }
    },
