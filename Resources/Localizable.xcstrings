    "Your questions and the parts of your record needed to answer them, including personal and leisure activity, are sent to the model provider.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문과 답변에 필요한 기록의 일부는 개인·여가 활동을 포함해 모델 제공 회사로 전송됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問と回答に必要な記録の一部は、個人・余暇の活動を含め、モデル提供会社に送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的问题以及回答所需的部分记录，包括个人和休闲活动，会发送给模型提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的問題以及回答所需的部分記錄，包括個人和休閒活動，會傳送給模型提供者。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Fragen und die zur Beantwortung benötigten Teile Ihrer Aufzeichnungen, einschließlich persönlicher Aktivitäten und Freizeitaktivitäten, werden an den Modellanbieter gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos questions et les parties de vos données nécessaires pour y répondre, y compris vos activités personnelles et de loisir, sont envoyées au fournisseur du modèle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus preguntas y las partes del registro necesarias para responderlas, incluidas las actividades personales y de ocio, se envían al proveedor del modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши вопросы и части записей, необходимые для ответа, включая личные занятия и досуг, отправляются поставщику модели."
          }
        }
      },
      "extractionState": "manual"
    },
