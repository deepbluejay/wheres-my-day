    "Activity storage could not be excluded from backups.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동 저장소를 백업에서 제외하지 못했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "活動ストレージをバックアップから除外できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法将活动存储排除在备份之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法將活動儲存空間排除於備份之外。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Aktivitätsspeicher konnte nicht von Backups ausgeschlossen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le stockage des activités n’a pas pu être exclu des sauvegardes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo excluir el almacenamiento de actividad de las copias de seguridad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось исключить хранилище активности из резервного копирования."
          }
        }
      }
    },
